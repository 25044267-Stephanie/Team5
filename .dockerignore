# Keep the build context small and secret-free.
.git
.gitignore
.env
.venv
.venv-pin
.pytest_cache
.ruff_cache
__pycache__
*.pyc
*.pyo
# data.json MUST be in the image so EC2/ECR can run idempotent room migrate.
# data.json.bak is an incomplete stub (3 sample rooms) — never ship it.
data.json.bak
tests
ansible
docs
README.md
Jenkinsfile
package-lock.json
render.yaml
docker-compose.yml
docker-compose.override.yml
docker-compose.prod.yml
docker-compose.prod.mysql-fallback.yml
.github
cloudwatch
reports
backups
*.md
.claude
.vscode
