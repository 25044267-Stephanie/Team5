# Copy this file to .env and fill in real values. Never commit .env.
FLASK_SECRET_KEY=replace-me

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=hotel_app
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=hotel_management
MYSQL_ROOT_PASSWORD=replace-with-a-separate-local-root-password

# Used only by tests/conftest.py — must point at a disposable database.
MYSQL_TEST_DATABASE=hotel_management_test

# Used only by scripts/seed_dev_users.py to create the two development
# demo accounts. Not used anywhere else in the app. Change these before
# using the seed script against anything other than a local dev database.
SEED_ADMIN_PASSWORD=admin123
SEED_USER_PASSWORD=user123
