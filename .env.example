# Copy this file to .env and fill in real values. Never commit .env.
# Do NOT use MySQL root as MYSQL_USER for the application.
# Do NOT put AWS Academy website login credentials here.
FLASK_SECRET_KEY=<NEW_FLASK_SECRET_KEY>

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hotel_app
MYSQL_PASSWORD=<NEW_HOTEL_APP_PASSWORD>
# Local Workbench / Windows Flask (exact schema name):
MYSQL_DATABASE=c270_hotel_management_local

# Used only by tests/conftest.py — disposable local test schema.
MYSQL_TEST_DATABASE=c270_hotel_management_test

# Required for local Docker Compose MySQL container bootstrap — NOT used by
# Windows Flask (which uses MYSQL_HOST=127.0.0.1 / MySQL84).
MYSQL_ROOT_PASSWORD=<NEW_LOCAL_MYSQL_ROOT_PASSWORD>
# Compose schema name (app container still uses MYSQL_HOST=db).
COMPOSE_MYSQL_DATABASE=c270_hotel_management_local
# Workbench → Docker MySQL. Prefer 3307 when Windows MySQL84 already owns 3306.
MYSQL_PUBLISH_PORT=3307

# Amazon RDS TLS (production). Local Workbench MySQL usually leaves these unset/false.
# MYSQL_SSL_REQUIRED=true
# MYSQL_SSL_CA=/path/to/rds-combined-ca-bundle.pem

# Used only by scripts/seed_dev_users.py (and Docker bootstrap) to create
# development demo accounts. Not used elsewhere in the app. Change these
# before seeding anything other than a local/dev database.
SEED_ADMIN_PASSWORD=admin123
SEED_STEPH_PASSWORD=steph123
# LOCAL DEV ONLY — do NOT set on EC2/production. Full seed can create username "user".
# Production/Jenkins use --ensure-demo-users (admin + steph only).
# SEED_USER_PASSWORD=user123

# ---------------------------------------------------------------------------
# Production / EC2 (docker-compose.prod.yml) — placeholders only
# ---------------------------------------------------------------------------
# Full ECR URI with immutable Git SHA tag, e.g.:
#   ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/c270-hotel-management:a1b2c3d
# Never use :latest alone for a classroom/demo deploy.
APP_IMAGE=ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/c270-hotel-management:GIT_SHA

# Production EC2 → RDS: set MYSQL_HOST to the private RDS endpoint (not "db").
# Academy fallback Compose MySQL uses docker-compose.prod.mysql-fallback.yml.

# Optional local alias used by docker-compose.yml (dev). Prod uses APP_IMAGE.
# IMAGE_NAME=c270-hotel-management:local
# APP_PORT=5050

# AWS helpers (scripts/aws/*) — set in your shell or GitHub Environment, not in git.
# AWS_REGION=us-east-1
# ECR_REPOSITORY=c270-hotel-management
# CW_CONFIG_PATH=/opt/c270-hotel-management/cloudwatch/amazon-cloudwatch-agent.json

