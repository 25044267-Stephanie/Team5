# Copy this file to .env and fill in real values. Never commit .env.
FLASK_SECRET_KEY=replace-me

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=hotel_app
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=hotel_management
MYSQL_ROOT_PASSWORD=replace-with-a-separate-local-root-password

# Used only by tests/conftest.py — must point at a disposable database.
MYSQL_TEST_DATABASE=hotel_management_test

# Used only by scripts/seed_dev_users.py to create the two development
# demo accounts. Not used anywhere else in the app. Change these before
# using the seed script against anything other than a local dev database.
SEED_ADMIN_PASSWORD=admin123
SEED_USER_PASSWORD=user123

# ---------------------------------------------------------------------------
# Production / EC2 (docker-compose.prod.yml) — placeholders only
# ---------------------------------------------------------------------------
# Full ECR URI with immutable Git SHA tag, e.g.:
#   123456789012.dkr.ecr.us-east-1.amazonaws.com/c270-hotel-management:a1b2c3d
# Never use :latest alone for a classroom/demo deploy.
APP_IMAGE=ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/c270-hotel-management:GIT_SHA

# Optional local alias used by docker-compose.yml (dev). Prod uses APP_IMAGE.
# IMAGE_NAME=c270-hotel-management:local
# APP_PORT=5050

# AWS helpers (scripts/aws/*) — set in your shell or GitHub Environment, not in git.
# AWS_REGION=us-east-1
# ECR_REPOSITORY=c270-hotel-management
# CW_CONFIG_PATH=/opt/c270-hotel-management/cloudwatch/amazon-cloudwatch-agent.json

